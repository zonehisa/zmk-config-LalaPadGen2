#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/naginata.dtsi>

#define DEFAULT_LAYER   0
#define OONISHI_LAYER   1
#define NAGINATA_LAYER  2
#define SECONDARY_LAYER 3
#define TERTIARY_LAYER  4
#define SYSTEM_LAYER    5
#define FUNCTION_LAYER  6
#define NUM_LAYER       7

&mt { quick-tap-ms = <200>; };

&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        z_mt: z_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        sp_lt: secondary_space_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <220>;
            require-prior-idle-ms = <125>;
            bindings = <&mo>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo SECONDARY_LAYER>, <&mo TERTIARY_LAYER>;
        };

        on_lt: onishi_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            bindings = <&on_on>, <&kp>;
        };

        off_lt: default_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            bindings = <&ng_off>, <&kp>;
        };
    };

    macros {
        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LANGUAGE_1 &kp INTERNATIONAL_4 &to NAGINATA_LAYER>
                ;
        };
        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LANGUAGE_2 &kp INTERNATIONAL_5 &to DEFAULT_LAYER>
                ;
        };
        ng_off_to_oonishi: ng_off_to_oonishi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LANGUAGE_2 &kp INTERNATIONAL_5 &to OONISHI_LAYER>
                ;
        };
        select_current_line: select_current_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(LEFT) &kp LS(LG(RIGHT))>
                ;
        };
        on_on: on_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LANGUAGE_2 &to OONISHI_LAYER>
                ;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };
        combo_ng_on {
            timeout-ms = <300>;
            bindings = <&ng_on>;
            key-positions = <15 16>;
            layers = <DEFAULT_LAYER OONISHI_LAYER>;
        };
        combo_ng_off {
            timeout-ms = <300>;
            bindings = <&ng_off_to_oonishi>;
            key-positions = <13 14>;
            layers = <DEFAULT_LAYER OONISHI_LAYER NAGINATA_LAYER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
            &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
            &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &mt2 LEFT_GUI SEMI
            &z_mt LEFT_SHIFT Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &mt LEFT_ALT PERIOD  &mt LEFT_SHIFT SLASH
            &mt LEFT_SHIFT ESC  &mo FUNCTION_LAYER  &lt SECONDARY_LAYER LANGUAGE_2  &sp_lt SECONDARY_LAYER SPACE  &mo NUM_LAYER  &mt LCTRL TAB  &mt LGUI BACKSPACE  &mo TERTIARY_LAYER  &mt RALT ENTER  &lt TERTIARY_LAYER LANGUAGE_1  &on_lt 0 LA(GRAVE)  &mt RCTRL BACKSLASH
            &mkp LCLK  &kp RIGHT  &kp DOWN  &kp LEFT  &kp UP  &kp UP  &kp LEFT  &kp DOWN  &kp RIGHT  &none
            &mkp LCLK  &mkp RCLK  &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            &kp LC(LEFT)  &kp LC(RIGHT)  &kp LC(UP)  &kp LC(DOWN)  &kp LCTRL  &kp LC(LEFT)  &kp LC(RIGHT)  &kp LC(UP)  &kp LC(DOWN)  &none
            >;
        };

        OONISHI_LAYER {
            display-name = "Oonishi";
            bindings = <
            &kp Q  &kp L  &kp U  &kp COMMA  &kp DOT  &kp F  &kp W  &kp R  &kp Y  &kp P
            &kp E  &kp I  &kp A  &kp O  &mt LEFT_SHIFT MINUS  &kp K  &kp T  &kp N  &kp S  &kp H
            &kp Z  &kp X  &kp C  &kp V  &kp SEMI  &kp G  &kp D  &kp M  &kp J  &kp B
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &off_lt 0 LA(GRAVE)  &trans
            &mkp LCLK  &kp RIGHT  &kp DOWN  &kp LEFT  &kp UP  &kp UP  &kp LEFT  &kp DOWN  &kp RIGHT  &none
            &mkp LCLK  &mkp RCLK  &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            &kp LC(LEFT)  &kp LC(RIGHT)  &kp LC(UP)  &kp LC(DOWN)  &kp LCTRL  &kp LC(LEFT)  &kp LC(RIGHT)  &kp LC(UP)  &kp LC(DOWN)  &ng_off
            >;
        };

        NAGINATA_LAYER {
            display-name = "Naginata";
            bindings = <
            &ng Q  &ng W  &ng E  &ng R  &ng T  &ng Y  &ng U  &ng I  &ng O  &ng P
            &ng A  &ng S  &ng D  &ng F  &ng G  &ng H  &ng J  &ng K  &ng L  &ng SEMI
            &ng Z  &ng X  &ng C  &ng V  &ng B  &ng N  &ng M  &ng COMMA  &ng DOT  &ng SLASH
            &trans  &trans  &trans  &ng SPACE  &trans  &trans  &trans  &trans  &ng ENTER  &trans  &off_lt 0 LA(GRAVE)  &trans
            &mkp LCLK  &kp RIGHT  &kp DOWN  &kp LEFT  &kp UP  &kp UP  &kp LEFT  &kp DOWN  &kp RIGHT  &none
            &mkp LCLK  &mkp RCLK  &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            &kp LC(LEFT)  &kp LC(RIGHT)  &kp LC(UP)  &kp LC(DOWN)  &kp LCTRL  &kp LC(LEFT)  &kp LC(RIGHT)  &kp LC(UP)  &kp LC(DOWN)  &ng_off
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &select_current_line  &kp BACKSPACE  &kp DELETE  &kp GRAVE  &kp MINUS
            &trans  &trans  &trans  &kp LS(LG(SPACE))  &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp ENTER
            &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &mt LEFT_ALT END  &kp LEFT_SHIFT
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans  &trans  &trans  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans  &trans  &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
            &kp SQT  &trans  &kp TILDE  &kp GRAVE  &kp LBKT  &kp RBKT  &kp DQT  &trans  &trans  &kp PRCNT
            &kp EQUAL  &kp PLUS  &kp AT  &trans  &kp LBRC  &kp RBRC  &kp TILDE  &kp AMPS  &kp STAR  &kp HASH
            &trans  &kp EXCL  &kp CARET  &trans  &kp LPAR  &kp RPAR  &kp DLLR  &trans  &kp KP_DIVIDE  &kp QMARK
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &mkp MB5  &trans  &mkp MB4  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
            &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
            &sys_reset  &bootloader  &kp F8  &kp F9  &kp F10  &sys_reset  &bootloader  &bt BT_CLR  &bt BT_CLR_ALL  &trans
            &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &tog NAGINATA_LAYER
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        FUNCTION_LAYER {
            display-name = "function_layer";
            bindings = <
            &kp LG(Q)  &kp F2  &kp F12  &kp LG(COMMA)  &kp LG(DOT)  &kp LG(F)  &kp LG(W)  &kp LG(R)  &kp LG(Y)  &kp LG(P)
            &kp LG(E)  &kp LG(I)  &kp LG(A)  &kp LG(O)  &kp LG(MINUS)  &kp LG(K)  &kp LG(T)  &kp LG(N)  &kp LG(S)  &kp LG(H)
            &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(SEMI)  &kp LG(G)  &kp LG(D)  &kp LG(M)  &kp LG(J)  &kp LG(B)
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &kp C_BRI_DN  &trans  &kp C_BRI_UP  &kp C_VOL_UP  &trans  &kp C_VOL_DN  &kp C_MUTE  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        NUM_LAYER {
            display-name = "num_layer";
            bindings = <
            &kp LC(Z)  &kp LS(LG(N4))  &kp LS(LG(N5))  &kp LS(LG(LBKT))  &kp LS(LG(RBKT))  &kp N7  &kp N8  &kp N9  &kp MINUS  &kp SLASH
            &kp LC(M)  &kp LC(COMMA)  &kp LC(DOT)  &kp LC(SLASH)  &kp LC(N)  &kp N4  &kp N5  &kp N6  &kp PLUS  &kp STAR
            &kp LC(F)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(A)  &kp N1  &kp N2  &kp N3  &kp COMMA  &kp EQUAL
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &kp DOT  &kp ENTER  &kp ENTER
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <SECONDARY_LAYER TERTIARY_LAYER>;
            then-layer = <SYSTEM_LAYER>;
        };
    };
};
